# ==============================================================================
# Compass Crew — Environment Variables Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env or .env.local and fill in your values.

# ------------------------------------------------------------------------------
# Supabase Configuration (Client & Server Public Keys)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ------------------------------------------------------------------------------
# Supabase Privileged Key (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT/BROWSER)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Optional in development, recommended in production)
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# Email Provider Credentials (Optional — configured in Admin Settings)
# ------------------------------------------------------------------------------
# Resend
RESEND_API_KEY=""

# Zoho Mail SMTP
ZOHO_SMTP_HOST=""
ZOHO_SMTP_USER=""
ZOHO_SMTP_PASSWORD=""

# Custom SMTP
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
